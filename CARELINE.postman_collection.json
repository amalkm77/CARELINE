{
  "info": {
    "name": "CARELINE Feedback API",
    "description": "Local API requests for signup, session-based admin access, and feedback management.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:5000"
    },
    {
      "key": "adminName",
      "value": "CARELINE Admin"
    },
    {
      "key": "adminEmail",
      "value": "admin@example.com"
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "feedbackId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Sign Up Admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{adminName}}\",\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/signup",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "signup"
          ]
        }
      }
    },
    {
      "name": "Log In Admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login succeeds', function () {",
              "  pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "login"
          ]
        }
      }
    },
    {
      "name": "Get Current Session",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/session",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "session"
          ]
        }
      }
    },
    {
      "name": "Submit Feedback",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Feedback is created', function () {",
              "  pm.response.to.have.status(201);",
              "  pm.collectionVariables.set('feedbackId', pm.response.json().id || '');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Sample Patient\",\n  \"department\": \"Cardiology\",\n  \"comments\": \"The staff were kind and the care was excellent.\",\n  \"ratings\": {\n    \"Doctor Consultation\": 5,\n    \"Nursing Care\": 5,\n    \"Cleanliness & Hygiene\": 4,\n    \"Hospital Facilities\": 4,\n    \"Emergency Services\": 4,\n    \"Pharmacy Service\": 5,\n    \"Waiting Time\": 3,\n    \"Staff Behaviour\": 5\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/feedback",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "feedback"
          ]
        }
      }
    },
    {
      "name": "List Feedback",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/feedback",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "feedback"
          ]
        }
      }
    },
    {
      "name": "Delete Feedback",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{baseUrl}}/api/feedback/{{feedbackId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "feedback",
            "{{feedbackId}}"
          ]
        }
      }
    },
    {
      "name": "Log Out Admin",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/api/logout",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "logout"
          ]
        }
      }
    }
  ]
}
